// ============================
//   التواصل المشفر العنقودي (P2P AES-GCM Mesh Broadcast)
// ============================
async fn broadcast_threat(ip: &str, port: &str, threat: &str, confidence: f64) {
    let client = Client::new();
    let peers = vec![
        "http://192.168.1.10:8080/cluster-report",
        "http://192.168.1.11:8080/cluster-report",
    ];

    let raw_key = env::var("STORM_CLUSTER_KEY").unwrap_or_else(|_| "0123456789abcdef0123456789abcdef".to_string());
    let key_bytes = raw_key.as_bytes();
    if key_bytes.len() < 32 {
        return;
    }
    let key = Key::from_slice(&key_bytes[..32]);
    let cipher = Aes256Gcm::new(key);
    
    // استخدام Nonce عشوائي مشفر ومتغير مع كل عملية بث
    let mut nonce_bytes = [0u8; 12];
    rand::thread_rng().fill_bytes(&mut nonce_bytes);
    let nonce = Nonce::from_slice(&nonce_bytes);

    let report = SovereignThreatReport {
        operator: get_operator_identity(),
        ip: ip.to_string(),
        port: port.to_string(),
        threat: threat.to_string(),
        confidence,
        timestamp: Utc::now().to_rfc3339(),
    };

    let plaintext = match serde_json::to_vec(&report) {
        Ok(v) => v,
        Err(_) => return,
    };

    let ciphertext = match cipher.encrypt(nonce, plaintext.as_ref()) {
        Ok(c) => c,
        Err(_) => return,
    };

    for peer in peers {
        let payload = json!({
            "operator_id": get_operator_identity(),
            "cipher_data": hex::encode(&ciphertext)
        });
        let _ = client.post(peer).json(&payload).send().await;
    }
}

