// ============================
fn enforce_kernel_hardening() {
    unsafe {
        libc::prctl(libc::PR_SET_DUMPABLE, 0, 0, 0, 0);
    }
    info!("HARDENING: Core dumps disabled (PR_SET_DUMPABLE set to 0).");

    let rlim = libc::rlimit {
        rlim_cur: 1024,
        rlim_max: 4096,
    };
    unsafe {
        libc::setrlimit(libc::RLIMIT_NOFILE, &rlim);
    }
}

