    error!("CORE ERROR in {} => {}", context, err);

    let token = env::var("STORM_TELEGRAM_TOKEN").unwrap_or_default();
    let chat_id = env::var("STORM_TELEGRAM_CHAT_ID").unwrap_or_default();

    if !token.is_empty() && !chat_id.is_empty() {
        tokio::spawn(async move {
