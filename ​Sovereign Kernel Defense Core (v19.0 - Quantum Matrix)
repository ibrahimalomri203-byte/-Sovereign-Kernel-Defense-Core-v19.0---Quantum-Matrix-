                info!("CLUSTER MESH: Received authentic peer sync block, length {}", cipher_hex.len());
            }
            warp::reply::json(&json!({"status": "acknowledged"}))
        });

    warp::serve(report_route).run(([0, 0, 0, 0], 8080)).await;
}

