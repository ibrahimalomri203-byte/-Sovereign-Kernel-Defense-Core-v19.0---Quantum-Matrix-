// ============================
//   موديول كشف التتبع والتصحيح (Anti-Debugging Guard)
// ============================
fn check_debugger_attachment() -> Result<bool, String> {
    let status_path = Path::new("/proc/self/status");
    if !status_path.exists() {
        return Ok(false);
    }

    let contents = fs::read_to_string(status_path).map_err(|e| e.to_string())?;
    for line in contents.lines() {
        if line.starts_with("TracerPid:") {
            let parts: Vec<&str> = line.split_whitespace().collect();
            if let Some(pid_str) = parts.get(1) {
                let tracer_pid: u32 = pid_str.parse().unwrap_or(0);
                if tracer_pid > 0 {
                    return Ok(true);
                }
            }
        }
    }
    Ok(false)
}

// ============================
//   موديول كشف الروتكتات وحقن المكتبات (LD_PRELOAD Rootkit Shield)
// ============================
fn check_rootkit_preload() -> Result<bool, String> {
    let preload_path = "/etc/ld.so.preload";
    if Path::new(preload_path).exists() {
        if let Ok(metadata) = fs::metadata(preload_path) {
            if metadata.len() > 0 {
                return Ok(true);
            }
        }
    }
    Ok(false)
}

// ============================
//   موديول فحص امتيازات العمليات والتصعيد الخفي
// ============================
fn audit_process_privileges() -> Vec<u32> {
    let mut high_priv_pids = Vec::new();
    let entries = match fs::read_dir("/proc") {
        Ok(v) => v,
        Err(_) => return high_priv_pids,
    };

    for entry in entries.flatten() {
        let filename = entry.file_name().to_string_lossy().to_string();
        if let Ok(pid) = filename.parse::<u32>() {
            let status_path = entry.path().join("status");
            if let Ok(content) = fs::read_to_string(status_path) {
                for line in content.lines() {
                    if line.starts_with("CapEff:") {
                        let caps = line.split_whitespace().nth(1).unwrap_or("0");
                        if caps != "0000000000000000" && pid > 1000 {
                            high_priv_pids.push(pid);
                        }
                    }
                }
            }
        }
    }
    high_priv_pids
}

// ============================
//   موديول التدقيق الشبكي الخفي ومنافذ الاستماع (Socket Auditor)
// ============================
fn audit_network_sockets() -> Vec<String> {
    let mut anomalous_ports = Vec::new();
    
    if let Ok(contents) = fs::read_to_string("/proc/net/tcp") {
        for line in contents.lines().skip(1) {
            let parts: Vec<&str> = line.split_whitespace().collect();
            if let (Some(local_addr), Some(state)) = (parts.get(1), parts.get(3)) {
                if *state == "0A" {
                    if let Some(port_hex) = local_addr.split(':').nth(1) {
                        if let Ok(port_num) = u32::from_str_radix(port_hex, 16) {
                            if port_num > 1024 && port_num != 8080 {
                                anomalous_ports.push(port_num.to_string());
                            }
                        }
                    }
                }
            }
        }
    }
    anomalous_ports
}

